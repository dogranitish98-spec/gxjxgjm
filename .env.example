# Copy to `.env` (never commit it). Every value is optional.

# Sign-in is OFF for local paper research. `.grok/app-env.json` already sets this;
# set it here too if you run Vite outside `npm run dev`.
VITE_AUTH_ENABLED=false

# Neon / Postgres for research history + paper journal.
# Leave empty to use the embedded PGLite database.
# DATABASE_URL=postgresql://user:pass@host/db

# xAI key for the optional "AI research" panel (evidence only; it never overrides the gate).
# XAI_API_KEY=

# Optional comma-separated STUN servers for the multiplayer module.
# VITE_STUN_URLS=
